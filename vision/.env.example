# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env никому не отправляйте и не выкладывайте: тут пароли.

# Адрес проекта Supabase (как в программе).
SUPABASE_URL=https://aatriitpqpwhdcehjzip.supabase.co
# Общий секрет с сервером: ТАКОЕ ЖЕ значение вы задаёте в Supabase
# (Edge Functions -> Secrets -> VISION_SECRET). Придумайте длинную случайную строку.
VISION_SECRET=

# Telegram: токен бота (от BotFather) и куда слать сообщения.
# Чат — число; для группы или канала оно начинается с -100.
# Можно несколько через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Адреса потоков камер (содержат логин и пароль камеры).
# Примеры:
#   Hikvision: rtsp://admin:ПАРОЛЬ@192.168.1.64:554/Streaming/Channels/102
#   Dahua/Imou: rtsp://admin:ПАРОЛЬ@192.168.1.108:554/cam/realmonitor?channel=1&subtype=1
#   Tapo:       rtsp://ЛОГИН:ПАРОЛЬ@192.168.1.50:554/stream2
CAM1_URL=
